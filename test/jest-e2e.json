{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(@nestjs/bullmq|@nestjs/bull-shared|@nestjs/schedule)/)"
  ],
  "globalSetup": "<rootDir>/setup-env.ts",
  "maxWorkers": 1,
  "testTimeout": 30000
}
